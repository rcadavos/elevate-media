# Supabase — Project Settings → API (https://supabase.com/dashboard)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server only — never expose to the browser. Used to create users from Admin → Directory.
SUPABASE_SERVICE_ROLE_KEY=

# Optional: set Site URL in Supabase Auth to match this app (e.g. http://localhost:3000 for dev).

# Resend — onboarding invite emails (https://resend.com). Server only.
RESEND_API_KEY=
# Verified sender in Resend (defaults to Resend onboarding address for testing).
INVITE_EMAIL_FROM=
# Optional: public origin for links in emails if it differs from the request URL (no trailing slash).
INVITE_APP_ORIGIN=
